#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

function echo_line() {
    printf %"$(tput cols)"s | tr " " "="
}
#-------------------------------------------------------------------------------
echo_line
echo -e "PULL\n"

"$dir/pull"
#-------------------------------------------------------------------------------
echo_line
echo -e "UPGRADE\n"

"$dir/each-without-project" sh -c '
        make -q upgrade ; test $? -eq 2 || \
        (\
            if script --version 2>&1 >/dev/null; then \
                script -q -e -c "make upgrade" /dev/null; \
            else \
                script -e /dev/null make upgrade; \
            fi \
        )'
#-------------------------------------------------------------------------------
echo_line
echo -e "REBUILD\n"

"$dir/each-without-project" sh -c '
    make -q build ; test $? -eq 2 || make build'
#-------------------------------------------------------------------------------
echo_line
echo -e "START\n"

"$dir/start"
#-------------------------------------------------------------------------------
echo_line
echo -e "STOP\n"

"$dir/stop"
#-------------------------------------------------------------------------------
echo_line
echo -e "COMPLETED\n"
