#!/usr/bin/env bash
set -Eeuo pipefail

dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

function echo_line() {
    printf %"$(tput cols)"s | tr " " "="
}
#-------------------------------------------------------------------------------
echo_line
echo -e "PULL\n"

"$dir/pull"
#-------------------------------------------------------------------------------
echo_line
echo -e "UPGRADE\n"

# shellcheck disable=SC2016
"$dir/each-without-project" sh -c '
        make -q upgrade
        status=$?
        if [ $status -eq 0 ]; then
            exit 0
        elif [ $status -eq 2 ]; then
            exit 1
        fi
        if script --version 2>&1 >/dev/null; then
            script -q -c "make upgrade" /dev/null
        else
            script /dev/null make upgrade
        fi'
#-------------------------------------------------------------------------------
echo_line
echo -e "REBUILD\n"

# shellcheck disable=SC2016
"$dir/each-without-project" sh -c '
    make -q build
    status=$?
    if [ $status -eq 0 ]; then
        exit 0
    elif [ $status -eq 2 ]; then
        exit 1
    fi
    make build'
#-------------------------------------------------------------------------------
echo_line
echo -e "START\n"

"$dir/start"
#-------------------------------------------------------------------------------
echo_line
echo -e "STOP\n"

"$dir/stop"
#-------------------------------------------------------------------------------
echo_line
echo -e "COMPLETED\n"
