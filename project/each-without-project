#!/usr/bin/env bash
set -Eeuo pipefail

f_projects=.projects

function echo_line() {
    printf %"$(tput cols)"s | tr " " "-"
}

if [ -f "$f_projects" ] ; then
    while IFS= read -r project || [ -n "$project" ]; do
        [ -z "$project" ] && continue
        pushd "$project" >/dev/null
        echo_line
        echo -e "$project\n" >&2
        "$@"
        popd >/dev/null
    done < "$f_projects"
fi
