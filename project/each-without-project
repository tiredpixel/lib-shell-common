#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

f_projects=.projects

# tput exits 2 with no terminal -- CI, cron, a make that is not on a tty --
# and a command substitution used as an argument cannot fail the command it is
# an argument to, so the width silently became empty and the rule vanished.
# Resolved first with a fallback, which is the shape the rest of this library
# was already corrected to.
function echo_line() {
    local cols

    cols=$(tput cols 2>/dev/null || echo 80)

    # To stderr, as the name printed beside it already is. On stdout the rule
    # lands in the data: project/tag-create captures this sweep's output to ask
    # whether a tag exists anywhere, and read back a line of dashes instead of
    # the tags -- so the check answered "not present" every time.
    printf %"$cols"s | tr " " "-" >&2
}

# The list is read on fd 3, not stdin, and fd 3 is closed to the child. On
# stdin the sweep hands its own input to every command it runs: anything that
# reads stdin drains the remaining projects, the next read sees EOF, and the
# loop ends early having reported nothing wrong. `script`, which project/upgrade
# wraps make in to keep a tty, does exactly that -- it forwards stdin to the pty
# it creates, so an upgrade swept one project and silently skipped the rest.
#
# The child keeps the terminal on stdin rather than /dev/null, which `script`
# needs to forward keystrokes and a git credential or passphrase prompt needs to
# be answerable at all.
if [ -f "$f_projects" ] ; then
    while IFS= read -r project <&3 || [ -n "$project" ]; do
        [ -z "$project" ] && continue
        pushd "$project" >/dev/null

        echo_line
        echo -e "$project\n" >&2
        "$@" 3<&-

        popd >/dev/null
    done 3< "$f_projects"
fi
