#!/usr/bin/env bash
set -Eeuo pipefail

while test ! -z "$(docker ps -f health=starting -f health=unhealthy -q)"; do
    cNames=()
    while IFS= read -r name; do
        cNames+=("$name")
    done < <(docker ps \
        -f health=starting -f health=unhealthy --format '{{.Names}}')

    echo -ne "\r\e[2KAwaiting ${SECONDS}s ${cNames[*]}"
    
    sleep 1
done

echo
