#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit failglob

dockerfile=${1:-Dockerfile}

# grep exits 1 when the Dockerfile pins nothing, pipefail carries that out, and
# errexit then ended the run with no diagnostic on a file that is perfectly
# valid. Nothing to re-pin is not a failure.
frozen=$(grep -E '^# FROMFREEZE (.*)$' "$dockerfile" || true)

if [ -z "$frozen" ]; then
    echo "$dockerfile: no # FROMFREEZE line, so there is nothing to re-pin" >&2
    exit 0
fi

while read -r line; do
    data=${line#"# FROMFREEZE "}
    repo=${data%:*}
    tag=${data#*:}

    echo "Pulling $repo:$tag"
    docker pull "$repo:$tag"

    echo "Digesting $repo:$tag"
    digest=$(docker inspect --format='{{index .RepoDigests 0}}' "$repo:$tag" | cut -d '@' -f2)
    echo "  => $digest"

    # Detect GNU or BSD sed and use the appropriate syntax
    if sed --version >/dev/null 2>&1; then
        # GNU sed
        sed -i -E "s|^FROM ${repo}[:@]\S+(.*)$|FROM $repo@$digest\1|g" "$dockerfile"
    else
        # BSD/macOS sed
        sed -i '' -E "s|^FROM ${repo}[:@][^ ]*(.*)$|FROM $repo@$digest\\1|g" "$dockerfile"
    fi
done <<< "$frozen"
